{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/send-email"
    },
    {
      "source": "/api",
      "destination": "https://safar-backend-swsw.onrender.com/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://safar-backend-swsw.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}